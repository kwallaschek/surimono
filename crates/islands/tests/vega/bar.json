{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 400, "height": 200, "padding": 5,
  "data": [{ "name": "table", "values": [
    {"category": "A", "amount": 28}, {"category": "B", "amount": 55}, {"category": "C", "amount": 43},
    {"category": "D", "amount": 91}, {"category": "E", "amount": 81}, {"category": "F", "amount": 53},
    {"category": "G", "amount": 19}, {"category": "H", "amount": 87}
  ] }],
  "scales": [
    { "name": "xscale", "type": "band", "domain": {"data": "table", "field": "category"}, "range": "width", "padding": 0.05, "round": true },
    { "name": "yscale", "domain": {"data": "table", "field": "amount"}, "nice": true, "range": "height" }
  ],
  "axes": [
    { "orient": "bottom", "scale": "xscale" },
    { "orient": "left", "scale": "yscale" }
  ],
  "marks": [
    { "type": "rect", "from": {"data": "table"},
      "encode": { "enter": {
        "x": {"scale": "xscale", "field": "category"}, "width": {"scale": "xscale", "band": 1},
        "y": {"scale": "yscale", "field": "amount"}, "y2": {"scale": "yscale", "value": 0},
        "fill": {"value": "steelblue"} } } },
    { "type": "text", "from": {"data": "table"},
      "encode": { "enter": {
        "x": {"scale": "xscale", "field": "category", "band": 0.5},
        "y": {"scale": "yscale", "field": "amount", "offset": -4},
        "align": {"value": "center"}, "text": {"field": "amount"}, "fill": {"value": "#333"} } } }
  ]
}
