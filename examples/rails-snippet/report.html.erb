<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= h @report.title %></title>
  <style>
    @page { size: A4; margin: 15mm; }
    /* Name the registered fonts: a generic family alone prints in a server font. */
    html { font-family: "Noto Sans", "Noto Sans JP"; font-size: 13px; color: #1f2328; }
    h1 { font-size: 21px; margin: 0 0 12px; }
    .surimono-island > svg { display: block; }
  </style>
</head>
<body>
  <h1><%= h @report.title %></h1>
  <p>Revenue by quarter, in thousands of euros.</p>

  <%= surimono_island "echarts", {
        title: { text: @report.title, textStyle: { fontSize: 14 } },
        textStyle: { fontFamily: "Noto Sans" },
        grid: { left: 48, right: 16, top: 40, bottom: 32 },
        xAxis: { type: "category", data: @report.quarters },
        yAxis: { type: "value", axisLabel: { formatter: "{value} k€" } },
        series: [{ type: "bar", data: @report.revenue }],
      }, width: 680, height: 300, id: "revenue" %>

  <p>Trend</p>
  <%= surimono_island "sparkline", { values: @report.trend, label: @report.trend_label },
                      width: 200, height: 24, id: "trend" %>
</body>
</html>
